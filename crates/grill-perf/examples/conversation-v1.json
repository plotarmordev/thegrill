    {
      "id": "tool-alpha",
      "messages": [
        {
          "role": "user",
          "content": "Call lookup_fact with key harbor."
        }
      ],
      "step": {
        "history": "alpha",
        "parent": "restore-alpha",
        "cache": "reported-prefix-hit",
        "expect": {
          "kind": "tool",
          "key": "harbor",
          "result": "sapphire"
        }
      }
    },
    {
      "id": "tool-followup",
      "messages": [
        {
          "role": "user",
          "content": "Return the local tool fixture value as the fact."
