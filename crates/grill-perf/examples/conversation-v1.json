      "step": {
        "history": "short",
        "parent": null,
        "cache": "reported-prefix-zero",
        "expect": {
          "kind": "json",
          "value": {
            "fact": "jade"
          },
          "strict": "{\"fact\":\"jade\"}"
        }
      }
    },
