{
  "version": 2,
  "name": "conversation-v1",
  "request": {
    "profile": "vllm-conversation-v1",
    "stream": false,
    "output": {
      "tokens": 128,
      "mode": "cap"
    },
    "cache": "observe",
    "temperature_milli": 0,
    "top_p_milli": 1000,
    "seed": 0,
    "thinking_control": {
      "kind": "vllm-enable-thinking-v1",
      "enabled": false
    }
  },
  "limits": {
    "total_ms": 10000,
    "idle_ms": 10000,
    "response_bytes": 65536,
    "wave_buffer_bytes": 4194304
  },
  "cases": [
    {
      "id": "prime-alpha",
      "messages": [
        {
          "role": "system",
          "content": "History alpha. Retain the declared fact. Return only a JSON object with key fact when asked. Context: {fill}"
        },
        {
          "role": "user",
          "content": "SET fact=copper. What is the fact?"
        }
      ],
      "fill": {
        "unit": "Neutral retained context block. ",
        "repeat": 256
      },
      "step": {
        "history": "alpha",
        "parent": null,
        "cache": "reported-prefix-zero",
        "expect": {
          "kind": "json",
          "value": {
            "fact": "copper"
          },
          "strict": null
        }
      }
    },
    {
      "id": "reuse-alpha",
      "messages": [
        {
          "role": "user",
          "content": "What is the fact?"
        }
      ],
      "step": {
        "history": "alpha",
        "parent": "prime-alpha",
        "cache": "reported-prefix-hit",
        "expect": {
          "kind": "json",
          "value": {
            "fact": "copper"
          },
          "strict": null
        }
      }
    },
    {
      "id": "prime-beta",
